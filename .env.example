# Copiar a .env y ajustar
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Vacío => SQLite local (db.sqlite3). En Vercel/Neon usar la URL de Postgres.
DATABASE_URL=

# CORS está abierto desde settings.py (autenticación por token Bearer, sin
# cookies entre dominios), así que no hay nada que configurar aquí.

# Minutos de vida del access token
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7

# --- Inteligencia artificial -------------------------------------------
# Opcional. Sin estas dos variables el revisor de cuidado cultural funciona
# igual, solo con la lista de términos que mantiene la comunidad; nada sale
# del servidor. Además de configurarlas, cada comunidad debe autorizar el
# envío externo en su campo `ai_settings` (sufijo `_externo`).
#
# GEMINI_MODEL no trae valor por defecto a propósito: los nombres de los
# modelos cambian seguido. Cópielo tal cual de Google AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=
