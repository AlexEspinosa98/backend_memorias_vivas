# Copiar a .env y ajustar
DJANGO_SECRET_KEY=cambia-esto-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Vacío => SQLite local (db.sqlite3). En Vercel/Neon usar la URL de Postgres.
DATABASE_URL=

# CORS está abierto desde settings.py (autenticación por token Bearer, sin
# cookies entre dominios), así que no hay nada que configurar aquí.

# Minutos de vida del access token
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=7
